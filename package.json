{
  "name": "krealink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rules": "firebase emulators:exec --project demo-krealink --only firestore,storage \"tsx --test tests/rules.test.ts\"",
    "test:unit": "tsx --test tests/policy.test.ts tests/r2.test.ts",
    "test:security": "tsx scripts/test_security_integrity.ts",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "firebase emulators:exec --project demo-krealink --only auth,firestore,storage \"node --conditions=react-server --import tsx --test tests/e2e.test.ts\""
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "firebase-admin": "^14.5.0",
    "next": "16.2.6",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@google-cloud/firestore": "^9.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
