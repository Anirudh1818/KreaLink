# FanStreak environment variables
# Copy this file to .env.local and fill in your Firebase web app values.
# These NEXT_PUBLIC_* keys are exposed to the browser by design — your real
# protection is firestore.rules, not these values.
#
# Find them in: Firebase Console → Project settings → General → Your apps → SDK setup.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Admins are NOT configured by env var or email. They are provisioned with
#   npm run admin:provision -- grant <email> --by "<operator>" [--require-mfa]
# which needs a service account (never commit it, never NEXT_PUBLIC_*):
#   GOOGLE_APPLICATION_CREDENTIALS=C:\secure\krealink-admin-sa.json
#   FIREBASE_PROJECT_ID=<project-id>
# (NEXT_PUBLIC_ADMIN_EMAILS is no longer used.)

# Server-side Firebase project id for ID-token verification in API routes
# (defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=

# GST verification: no provider is bundled. To automate GSTIN lookups, integrate
# an authorised GSP in src/lib/server/gstProvider.ts and add its server-only
# credentials here. Without one, brand applications go to manual admin review.

# Razorpay UPI mandate keys. Server secrets (no NEXT_PUBLIC) stay on the server.
# Create a daily-frequency Plan in the Razorpay dashboard and put its id here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_DAILY_PLAN_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
