rules_version = '2';

// KreaLink Marketplace Firestore Security Rules
// --------------------------------------------------------------------------
// Ownership-based, auth-gated rules protecting creator profiles, portfolios,
// brand workspaces, creative briefs, invitations, and engagements.
// --------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['saxenaanirudh59@gmail.com'];
    }

    // Profile photo size check (inline base64 max 900KB)
    function photoWithinLimit(data) {
      return !('profilePhoto' in data.keys())
        || (data.profilePhoto is string && data.profilePhoto.size() < 900000);
    }

    // ==========================================
    // 1. Creators & Portfolios
    // ==========================================
    match /creators/{username} {
      // Public profiles can be browsed in discovery & creator profiles
      allow read: if true;

      // Creator profile create / update (owner or admin)
      allow create, update: if photoWithinLimit(request.resource.data) && (
        isAdmin() || (
          isSignedIn() && (
            !('ownerUid' in resource.data) ||
            resource.data.ownerUid == request.auth.uid ||
            request.resource.data.ownerUid == request.auth.uid
          )
        )
      );

      allow delete: if isAdmin();

      // Subcollection: creators/{username}/portfolio/{portfolioId}
      match /portfolio/{portfolioId} {
        allow read: if true;
        allow write: if isAdmin() || isSignedIn();
      }
    }

    // ==========================================
    // 2. Brands & Agencies
    // ==========================================
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isSignedIn() && (
          !('ownerUid' in resource.data) ||
          resource.data.ownerUid == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid
        )
      );
    }

    // ==========================================
    // 3. Creative Briefs
    // ==========================================
    match /briefs/{briefId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // ==========================================
    // 4. Invitations & Engagements
    // ==========================================
    match /invitations/{invitationId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /engagements/{engagementId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // ==========================================
    // 5. Default Deny
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
